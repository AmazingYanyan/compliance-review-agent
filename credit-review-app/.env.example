# 本地配置样例，无有效密钥。复制为 .env 后填入真实值，禁止提交真实 .env。
APP_MODE=real
PROJECT_NAME=信贷资料核对
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_LONG_SECRET
BIND_HOST=127.0.0.1
API_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_DATABASE_PASSWORD@db:5432/app
DATA_DIR=/data
PIPELINE_CONFIG_VERSION=pipeline-v1

# 初始账号，JSON 数组；seed-users 同步（创建/启用配置账号、禁用不在配置里的账号）
INITIAL_USERS_JSON='[{"username":"liyanyan","password":"CHANGE_ME_PASSWORD_1"},{"username":"admin","password":"CHANGE_ME_PASSWORD_2"}]'

# 上传限额（工程初始值）
UPLOAD_MAX_FILES_PER_TASK=50
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_TASK_BYTES=314572800
UPLOAD_MAX_FILE_PAGES=500
UPLOAD_MAX_TASK_PAGES=1000

# OCR（P2+ 使用）
OCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR_ACCESS_TOKEN=
OCR_MODEL=PaddleOCR-VL-1.6
OCR_POLL_INTERVAL_SECONDS=5
OCR_TOTAL_TIMEOUT_SECONDS=1800
OCR_REQUEST_TIMEOUT_SECONDS=60
OCR_CONNECT_TIMEOUT_SECONDS=10
OCR_MAX_ACTIVE_JOBS=1
OCR_JSONL_MAX_BYTES=104857600
OCR_IMAGE_MAX_BYTES=20971520
OCR_IMAGE_MAX_PIXELS=40000000
OCR_TASK_ARTIFACT_MAX_BYTES=2147483648
OCR_IMAGE_HOSTS=["pplines-online.bj.bcebos.com"]

# LLM（P2+ 使用）
LLM_API_BASE=https://ws-mec6kz71ur1bxnwr.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_CONCURRENCY=2
LLM_MAX_TRANSIENT_RETRIES=2
LLM_MAX_FORMAT_REPAIRS=1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_WINDOW_CHARACTERS=8000
LLM_WINDOW_OVERLAP_CHARACTERS=500
VISION_IMAGES_PER_BATCH=4
VISION_MAX_IMAGE_EDGE=1600
